# 统一换行符为 LF，避免 Windows / macOS 协作时整文件 diff 噪音
* text=auto eol=lf

# 二进制文件不做换行符转换
*.docx binary
*.doc binary
*.xlsx binary
*.pptx binary
*.db binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# 明确文本类型
*.py text
*.md text
*.json text
*.yml text
*.yaml text
*.html text
*.css text
*.txt text
*.sh text
